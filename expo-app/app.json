{
  "expo": {
    "name": "RenewX",
    "slug": "renewx-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.renewx.mobile",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "tez",
          "phonepe",
          "paytmmp",
          "tez",
          "phonepe",
          "paytmmp"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.renewx.mobile",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png",
      "name": "RenewX | Certified Pre-Owned Electronics Marketplace",
      "shortName": "RenewX",
      "themeColor": "#ffc400",
      "backgroundColor": "#ffffff"
    },
    "extra": {
      "eas": {
        "projectId": "67751613-3615-45fe-a3bc-2cf4a5c76179"
      }
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#059669",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffc400",
          "defaultChannel": "default"
        }
      ],
      "expo-web-browser",
      "expo-sharing",
      [
        "@sentry/react-native/expo",
        {
          "organization": "computer-science-engineering",
          "project": "react-native"
        }
      ],
      "./plugins/withRenewXRichNotifications.js"
    ],
    "owner": "dhushyandhs-workspace",
    "scheme": ["renewx", "com.renewx.mobile"]
  }
}
