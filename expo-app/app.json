{
  "expo": {
    "name": "RenewX",
    "slug": "renewx-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/67751613-3615-45fe-a3bc-2cf4a5c76179",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.renewx.mobile",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "tez",
          "phonepe",
          "paytmmp",
          "tez",
          "phonepe",
          "paytmmp"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.renewx.mobile",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "renewx.expo.app",
              "pathPrefix": "/product"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "renewx",
              "host": "product"
            },
            {
              "scheme": "com.renewx.mobile",
              "host": "product"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png",
      "name": "RenewX",
      "shortName": "RenewX",
      "themeColor": "#FFFFFF",
      "backgroundColor": "#FFFFFF"
    },
    "extra": {
      "eas": {
        "projectId": "67751613-3615-45fe-a3bc-2cf4a5c76179"
      }
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffc400",
          "defaultChannel": "default"
        }
      ],
      "expo-web-browser",
      "expo-sharing",
      [
        "@sentry/react-native/expo",
        {
          "organization": "computer-science-engineering",
          "project": "react-native"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.razorpay.** { *; }\n-dontwarn com.razorpay.**\n-keep class com.google.android.gms.auth.api.signin.** { *; }\n-keep class com.renewx.mobile.** { *; }"
          }
        }
      ],
      "./plugins/withRenewXRichNotifications.js"
    ],
    "owner": "dhushyandhs-workspace",
    "scheme": ["renewx", "com.renewx.mobile"]
  }
}
