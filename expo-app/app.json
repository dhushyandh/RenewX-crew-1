{
  "expo": {
    "name": "RenewX",
    "slug": "renewx-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.renewx.mobile",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "tez",
          "phonepe",
          "paytmmp"
        ]
      }
    },
    "android": {
      "package": "com.renewx.mobile",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "67751613-3615-45fe-a3bc-2cf4a5c76179"
      }
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#ffc400"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#059669",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffc400",
          "defaultChannel": "default"
        }
      ]
    ],
    "scheme": "renewx"
  }
}
