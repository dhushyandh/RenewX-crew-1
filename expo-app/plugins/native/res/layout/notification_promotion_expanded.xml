<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FFFFFF">

    <!-- Top header: Brand badge + Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RenewX Deals"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="@drawable/notification_badge_bg"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/notification_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔥 Weekend Device Deals 🔥"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Subtitle / Body -->
    <TextView
        android:id="@+id/notification_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Blockbuster deals on selected devices"
        android:textSize="12sp"
        android:textColor="#64748B"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_marginBottom="10dp" />

    <!-- Two Side-by-Side Product Cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- PRODUCT 1 CARD -->
        <LinearLayout
            android:id="@+id/product1_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/notification_card_bg"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true">

            <!-- Product 1 Image Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:padding="6dp"
                android:background="#F8FAFC">

                <ImageView
                    android:id="@+id/product1_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="Product 1 Image" />
            </FrameLayout>

            <!-- Product 1 Details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/product1_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="iPhone 14 Pro"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <!-- Price row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/product1_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹53,999"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A" />

                    <TextView
                        android:id="@+id/product1_old_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹69,999"
                        android:textSize="10sp"
                        android:textColor="#94A3B8"
                        android:layout_marginStart="5dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- RenewX Yellow Footer Banner -->
            <TextView
                android:id="@+id/product1_footer_text"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:background="@drawable/notification_card_footer_bg"
                android:gravity="center"
                android:text="View Deal →"
                android:textColor="#000000"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- PRODUCT 2 CARD -->
        <LinearLayout
            android:id="@+id/product2_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/notification_card_bg"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:focusable="true">

            <!-- Product 2 Image Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:padding="6dp"
                android:background="#F8FAFC">

                <ImageView
                    android:id="@+id/product2_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="Product 2 Image" />
            </FrameLayout>

            <!-- Product 2 Details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/product2_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Galaxy S23"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <!-- Price row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/product2_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹38,999"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A" />

                    <TextView
                        android:id="@+id/product2_old_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹64,999"
                        android:textSize="10sp"
                        android:textColor="#94A3B8"
                        android:layout_marginStart="5dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- RenewX Yellow Footer Banner -->
            <TextView
                android:id="@+id/product2_footer_text"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:background="@drawable/notification_card_footer_bg"
                android:gravity="center"
                android:text="View Deal →"
                android:textColor="#000000"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
