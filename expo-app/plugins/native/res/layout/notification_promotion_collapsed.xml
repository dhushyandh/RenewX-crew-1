<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FFFFFF">

    <!-- Top header: Brand badge + Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RenewX Deals"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="@drawable/notification_badge_bg"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/notification_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔥 Weekend Device Deals 🔥"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Subtitle / Body -->
    <TextView
        android:id="@+id/notification_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Blockbuster deals on selected devices • Tap to view"
        android:textSize="12sp"
        android:textColor="#475569"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_marginBottom="6dp" />

    <!-- Two product mini preview chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/collapsed_product1_preview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📱 iPhone 14 Pro"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • "
            android:textColor="#94A3B8" />

        <TextView
            android:id="@+id/collapsed_product2_preview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📱 Galaxy S23"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
