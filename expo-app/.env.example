# Expo public environment configuration
# Local Android emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
# Physical Android device:
# EXPO_PUBLIC_API_URL=http://YOUR-LAN-IP:5000/api
# Production:
EXPO_PUBLIC_API_URL=https://renewx-crew-server.onrender.com/api

# Optional: configure only a real RenewX support number.
EXPO_PUBLIC_SUPPORT_PHONE=
