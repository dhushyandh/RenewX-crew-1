# Expo public environment configuration
# Use your computer's LAN IP when testing on a physical Android device.
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.10:5000/api
#
# Android Studio emulator can use:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
