    "expo-updates": "~57.0.24",
    "expo-web-browser": "~57.0.3",
    "html2pdf.js": "^0.14.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-razorpay": "^3.0.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
