# Copy this file to server/.env and fill in real values. Never commit real secrets.

NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# In production, set this explicitly. Do not use *.
# CORS_ORIGINS=https://your-web-domain.example
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=<long-random-secret>
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=

# Comma-separated Google OAuth client IDs (Web, Android, iOS)
GOOGLE_CLIENT_IDS=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Persistent product image storage. Required in production.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# Production Observability & Error Tracking (Optional)
SENTRY_DSN=https://eeabeb41e706de2938decc6a3800f32d@o4512156615114752.ingest.us.sentry.io/4512156619505664

# OpenWA WhatsApp Integration (Self-hosted)
# Local development: OpenWA runs on Docker Desktop on Windows at http://localhost:2785
# Cloud production (e.g. Render, Railway, AWS): localhost refers to the container environment,
# NOT your local Windows machine. To connect a cloud backend to your local OpenWA instance,
# use a secure tunnel (e.g. Cloudflare Tunnel, Tailscale, or ngrok) or host OpenWA on a cloud VM.
# Protect OpenWA endpoints: never expose OpenWA API to public internet without X-API-Key or network auth.
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=
# OpenWA Session UUID (found in OpenWA dashboard or data/sessions).
# If left empty, RenewX auto-resolves the active ready session UUID via GET /api/sessions.
OPENWA_SESSION_ID=
