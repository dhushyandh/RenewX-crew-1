# Copy this file to server/.env and fill in real values. Never commit real secrets.

NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# In production, set this explicitly. Do not use *.
# CORS_ORIGINS=https://your-web-domain.example
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=<long-random-secret>
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=

# Comma-separated Google OAuth client IDs (Web, Android, iOS)
GOOGLE_CLIENT_IDS=


RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Persistent product image storage. Required in production.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# Production Observability & Error Tracking (Optional)
SENTRY_DSN=https://eeabeb41e706de2938decc6a3800f32d@o4512156615114752.ingest.us.sentry.io/4512156619505664

